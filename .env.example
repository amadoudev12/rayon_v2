# Adresse du backend vers laquelle le serveur Vite (npm run dev / npm run preview)
# transmet les requêtes /api. Le navigateur, lui, n'appelle que le site.
API_PROXY_TARGET="http://localhost:4000"

# Production uniquement, et seulement si l'API est servie sur une autre origine
# que le site (ex : https://api.exemple.com, sans « / » final). Laisser vide
# quand l'hébergeur du site transmet lui-même /api au backend.
VITE_API_URL=""
